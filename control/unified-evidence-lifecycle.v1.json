{
  "schemaVersion": "1.0.0",
  "kind": "unified-evidence-lifecycle",
  "status": "candidate-not-operational",
  "owner": "BlueDragon33/Software-Blueprint-Hub",
  "dependsOnConstitution": {
    "policyId": "blueprint-os:universal-century-grade",
    "version": "1.3.0",
    "activeLawUnchanged": true
  },
  "canonicalReferences": {
    "departments": "control/execution-department-ownership.v1.json",
    "mockupContract": "control/ui-mockup-roundtrip.contract.v1.json",
    "mockupAliases": "control/ui-mockup-command-aliases.v1.json",
    "mockupRegistry": "control/ui-mockup-registry.v1.json",
    "mockupWorkflow": "prompt-workflows/templates/ui-mockup-roundtrip.v1.json",
    "recoveryContract": "control/execution-continuity-r33.contract.v1.json",
    "recoveryAliases": "control/execution-continuity-r33-aliases.v1.json"
  },
  "scope": {
    "appsOwn": [
      "product-source",
      "real-screenshots",
      "mockup-image-and-spec",
      "tester-bug-issues",
      "test-evidence"
    ],
    "hubOwns": [
      "universal-policy-candidates",
      "shared-role-contracts",
      "workflow-definition",
      "read-only-evidence-evaluation"
    ],
    "appManagementOwns": [
      "app-registry",
      "scoped-runtime-and-device-management"
    ],
    "newCentralDatabase": false
  },
  "workflow": [
    {
      "id": "scope",
      "role": "product",
      "dependsOn": [],
      "requires": [
        "appId",
        "sourceSha",
        "targetSurfaceOrWorkItem",
        "userGoal"
      ],
      "delivers": "SOURCE_BOUND"
    },
    {
      "id": "design",
      "role": "architecture",
      "dependsOn": [
        "scope"
      ],
      "requires": [
        "real-design-contract"
      ],
      "delivers": "DESIGN_REVIEWABLE"
    },
    {
      "id": "mockup",
      "role": "experience",
      "dependsOn": [
        "design"
      ],
      "applicability": "user-facing-only",
      "requires": [
        "image-and-spec-with-digests",
        "verified-component-map"
      ],
      "delivers": "VISUAL_REVIEWABLE"
    },
    {
      "id": "implement",
      "role": "implementation",
      "dependsOn": [
        "design"
      ],
      "requires": [
        "actual-source-diff",
        "exact-build-or-commit"
      ],
      "delivers": "RUNNABLE_CANDIDATE"
    },
    {
      "id": "verify",
      "role": "verification",
      "dependsOn": [
        "implement"
      ],
      "requires": [
        "observed-real-functional-test",
        "critical-regressions"
      ],
      "delivers": "SLICE_VERIFIABLE"
    },
    {
      "id": "tester",
      "role": "verification",
      "dependsOn": [
        "verify"
      ],
      "applicability": "release-candidate-only",
      "requires": [
        "real-user-persona-scenario",
        "reproducible-defect-spec-or-observed-success",
        "measured-effectiveness-where-applicable"
      ],
      "delivers": "TESTER_EVIDENCE_READY"
    },
    {
      "id": "review",
      "role": "professional-review",
      "dependsOn": [
        "design"
      ],
      "requires": [
        "evidence-matching-requested-tier",
        "separate-reviewer-or-authority-for-protected-gate"
      ],
      "delivers": "REVIEW_DECISION_CANDIDATE",
      "applicability": "any-reviewed-maturity-stage"
    },
    {
      "id": "release",
      "role": "release",
      "dependsOn": [
        "review",
        "tester"
      ],
      "applicability": "production-release-only",
      "requires": [
        "independent-acceptance",
        "trusted-gate-receipts",
        "separate-production-authority"
      ],
      "delivers": "RELEASE_PROPOSAL_ONLY"
    },
    {
      "id": "observe",
      "role": "operations",
      "dependsOn": [
        "release"
      ],
      "applicability": "deployed-only",
      "requires": [
        "observed-deployment",
        "user-journey-and-health-trace"
      ],
      "delivers": "OBSERVATION_EVIDENCE"
    }
  ],
  "recovery": {
    "intent": "RESUME_VERIFIED_WORK",
    "scope": "every-stage",
    "requires": [
      "verified-checkpoint",
      "current-source-HEAD",
      "side-effect-readback-before-retry"
    ],
    "noBackgroundWork": true,
    "noBlindReplay": true,
    "doesNotAutoGrantGate": true
  },
  "evidenceStates": [
    "NOT_REVIEWABLE",
    "EVIDENCE_FORMAT_READY",
    "NOT_APPLICABLE_PENDING_REVIEW",
    "TESTER_SPEC_FORMAT_READY",
    "UNVERIFIED",
    "BLOCKED",
    "PASS_WITH_SCOPE"
  ],
  "guardrails": {
    "screenImageNeverProvesFunction": true,
    "nonUIVisualNotApplicable": true,
    "codeReviewBeforeCompleteProduct": true,
    "applicationTesterRequiresRealRunnableBuild": true,
    "mockupApprovalNotReleaseApproval": true,
    "reviewerIndependenceRequiredForProtectedGates": true,
    "aiCannotSelfRatify": true,
    "ciCannotClaimWholeProductPass": true,
    "duplicateApprovalDatabasesForbidden": true
  },
  "implementationBoundary": {
    "candidateReadOnlyOrchestration": true,
    "doesNotTriggerGenerationOrWrite": true,
    "noRuntimeDeployment": true,
    "noAutomaticReviewSignoff": true,
    "noReleaseAuthority": true
  },
  "consolidatesPRs": [
    134,
    136,
    140
  ],
  "evidenceTrustBoundary": {
    "submittedStructureIsNotAuthentication": true,
    "callerClaimedVerifiedByTrustedAdapterIsNotSufficient": true,
    "externalProviderReadbackRequiredForVerifiedEvidence": true,
    "sourceShaAndDigestMustBeCrossCheckedAtTrustedSource": true,
    "independentReviewerMustBeAuthenticatedAndDistinctForProtectedGates": true,
    "neverInferProductPassFromScreenshotOrCI": true,
    "noRealTesterSessionClaimFromFilledBugReport": true,
    "unverifiedOrUnreachableAuthority": "UNVERIFIED",
    "thisCandidateDoesNotInstallRuntimeVerifier": true
  },
  "nextActionUX": {
    "schemaVersion": "1.0.0",
    "kind": "universal-next-action-suggestion",
    "status": "candidate-not-active",
    "scope": {
      "projectCoverage": "all-existing-active-and-future-governed-projects-on-adoption",
      "channels": [
        "ChatGPT-conversation",
        "governed-client-with-adapter"
      ],
      "mustNotClaimAutomaticDeploymentToExistingApps": true,
      "reuseExistingWorkflowRegistry": true,
      "newDatabase": false,
      "oneCentralContract": true
    },
    "trigger": "Offer preparation first where authentic preflight gate is absent; only present end-to-end after host-verifiable prerequisites for that exact scope/revision.",
    "surfaces": {
      "chat": "Prioritize one-click prerequisite preparation when an end-to-end ready gate has not been independently verified; the end-to-end button is allowed only after the trusted host verifies its preflight for the exact work slice. The button does not run in background.",
      "nativeApp": "optional project-owned UI using shared versioned semantics; real implementation and QA required",
      "noAction": "omit when goal complete, no clear action, identity ambiguous or action unavailable"
    },
    "actionKinds": [
      {
        "kind": "prepare",
        "labelVi": "Chuẩn bị đủ điều kiện",
        "intent": "PREPARE_END_TO_END_PREREQUISITES",
        "requires": [
          "exact-work-item",
          "readable-current-state"
        ],
        "stages": [
          "read-live-HEAD-and-policy",
          "reconcile-objective-and-acceptance",
          "verify-authorization-and-dependencies",
          "prepare-tools-test-and-rollback",
          "fix-eligible-gaps",
          "independently-readback",
          "checkpoint-with-evidence"
        ],
        "mayClaimSuccess": false,
        "doesNotGrantEndToEndGate": true,
        "doesNotRunProductionActions": true
      },
      {
        "kind": "end-to-end",
        "labelVi": "Triển khai từ đầu đến cuối",
        "intent": "EXECUTE_AUTHORIZED_END_TO_END",
        "requires": [
          "exact-work-item",
          "known-acceptance-criteria",
          "actual-live-HEAD",
          "valid-existing-authorization"
        ],
        "stages": [
          "reconcile",
          "identify-smallest-needed-work",
          "implement",
          "test",
          "fix-boundedly",
          "verify",
          "checkpoint",
          "next-eligible-stage"
        ],
        "mode": "interactive-until-real-intervention-boundary",
        "stopReasons": [
          "protected-human-approval",
          "independent-reviewer-unavailable",
          "missing-authorized-identity-or-resource",
          "unknown-mutation-outcome",
          "repeat-failure-without-new-evidence",
          "attempt-budget-exhausted",
          "tool-or-session-unavailable",
          "truly-ambiguous-user-intent"
        ],
        "never": [
          "background-execution-promise",
          "bypass-protection",
          "invent-test-evidence",
          "auto-approve-constitution",
          "auto-deploy-production-without-current-grant"
        ],
        "mayClaimSuccess": false,
        "doesNotAuthorizeNewActions": true
      },
      {
        "kind": "continue",
        "labelVi": "Tiếp tục công việc",
        "requires": [
          "exact-work-item",
          "verified-context"
        ],
        "intent": "RESUME_VERIFIED_WORK",
        "mayClaimSuccess": false
      },
      {
        "kind": "status",
        "labelVi": "Kiểm tra tiến độ",
        "requires": [
          "exact-work-item"
        ],
        "intent": "REPORT_CHECKPOINT",
        "readOnly": true
      },
      {
        "kind": "fix",
        "labelVi": "Sửa lỗi",
        "requires": [
          "exact-work-item",
          "observed-defect"
        ],
        "intent": "DIAGNOSE_BOUNDED_DEFECT",
        "mayClaimSuccess": false
      },
      {
        "kind": "review",
        "labelVi": "Chuẩn bị review",
        "requires": [
          "exact-work-item"
        ],
        "intent": "PREPARE_REVIEW",
        "mustNotSelfApprove": true
      }
    ],
    "recommendationRules": {
      "maximumButtons": 3,
      "maximumPrimary": 1,
      "alwaysTargetExactProjectAndWorkItem": true,
      "skipInertControls": true,
      "omitForNonActionableReplies": true,
      "avoidPromptDuplication": true,
      "preferSinglePrimaryWhenObvious": true,
      "noInferredApproval": true,
      "noDirectIrreversibleAction": true,
      "protectedTasksRequireNewGateVerification": true,
      "oneClickSubmitsRequestNotCompletesTask": true,
      "noBackgroundExecutionPromise": true,
      "hideWhenStatusDoneOrBlockedWithoutSafeAction": true,
      "chatButtonsArePresentationNotRepositoryFeature": true,
      "preferEndToEndPrimaryForMultiStepEligibleWork": true,
      "endToEndContinuesWithoutUnnecessaryConfirmation": true,
      "endToEndRequiresExistingAuthorityAndLiveReadback": true,
      "endToEndStopsOnlyAtRealCapabilityOrAuthorityGate": true,
      "endToEndRespectsFiniteR7RepairBudget": true,
      "endToEndSessionBound": true,
      "endToEndNeverOverridesReviewOrRelease": true,
      "endToEndAlwaysPersistsTrustedCheckpointIfAuthorized": true,
      "preflightBeforeEndToEndMandatory": true,
      "noEndToEndButtonFromCallerFlags": true,
      "prepareAllResolvablePrerequisitesFirst": true,
      "distinguishStartFromReleaseGates": true,
      "hostVerifiedGateRequiredToOfferEndToEnd": true
    },
    "adoption": {
      "governanceOwnedBy": "BlueDragon33/Software-Blueprint-Hub",
      "appOwnedImplementation": "product-repository",
      "appManagementRole": "operational-routing-only",
      "constitutionalRatificationRequiredForNormativeEnforcement": true,
      "notAutoInstalledOnChatGPT": true,
      "canonicalGateUnchanged": true,
      "productionAuthorized": false
    },
    "prerequisiteGate": {
      "version": "1.0.0",
      "status": "candidate-not-runtime-enabled",
      "appliesTo": "all-existing-active-and-future-governed-projects-after-adoption",
      "gateOrder": [
        "PREPARE_REQUIREMENTS",
        "VERIFY_PREREQUISITES",
        "EXECUTE_ELIGIBLE_STAGES",
        "STAGE_SPECIFIC_QUALITY_GATES",
        "COMPLETE_WITH_EVIDENCE"
      ],
      "startNecessary": [
        {
          "id": "canonical-target",
          "requires": "canonical project ID, repository, work item, exact branch and live HEAD"
        },
        {
          "id": "approved-objective",
          "requires": "user objective, scope, expected deliverable and explicit out-of-scope boundaries"
        },
        {
          "id": "acceptance-contract",
          "requires": "reproducible acceptance criteria per actual work slice and measurable stop predicate"
        },
        {
          "id": "authority-context",
          "requires": "authenticated currently authorized access for each intended ordinary action; privileged scope separately gated"
        },
        {
          "id": "dependency-map",
          "requires": "dependency and order map; blockers recorded and safe independent tasks distinguished"
        },
        {
          "id": "execution-capability",
          "requires": "available scoped tools/environment and bounded time/attempt/file/token budget"
        },
        {
          "id": "risk-verification",
          "requires": "risk classification, focused test plan, directly affected regressions and evidence owner"
        },
        {
          "id": "recovery-and-state",
          "requires": "R33 verified checkpoint/current HEAD, no unknown in-flight mutation, version-safe rollback for risky writes"
        }
      ],
      "startSufficient": "Every applicable startNecessary condition has been independently verified from canonical sources for the selected work slice, no unresolved hard blocker or unknown side-effect outcome; this is sufficient ONLY to START bounded authorized implementation, never for downstream QA/merge/release.",
      "preparationPolicy": {
        "finishAllOrdinaryPreparatoryWorkWithoutAsking": true,
        "iterateWithinFiniteR7Budget": true,
        "readbackAfterWrites": true,
        "continueSafeIndependentPreparationsWhenProtectedGateBlocks": true,
        "prohibitSpeculativePrerequisitePass": true,
        "unresolvedPrerequisitesYieldBlockedOrUnverified": true,
        "unknownSourceCannotBecomePassedFromCallerFlag": true,
        "recordOneNextActionAndEvidence": true
      },
      "stageGates": [
        {
          "stage": "implementation",
          "requires": "exact patch SHA and applicable focused tests; preserved existing critical journeys"
        },
        {
          "stage": "independent-review",
          "requires": "authenticated distinct reviewer and source-matched findings where review is mandated"
        },
        {
          "stage": "merge",
          "requires": "current branch/base comparison, branch policy, mandatory CI, applicable reviews, valid merge authority"
        },
        {
          "stage": "release",
          "requires": "release candidate, risk-appropriate actual tester/UX evidence, trusted gates, signed/provenanced artifacts, separate current Production authority and rollback"
        },
        {
          "stage": "observation",
          "requires": "authorized deployment exists, health and incident observation tied to deployed revision"
        }
      ],
      "independence": "Do not demand later-stage evidence before its stage exists; do not infer approval from a claim, screenshot, test PASS or project membership.",
      "statuses": [
        "NEEDS_PREPARATION",
        "PREPARATION_FORMAT_READY_UNVERIFIED",
        "WAITING_ON_AUTHORITY",
        "BLOCKED",
        "READY_FROM_TRUSTED_HOST_ONLY"
      ],
      "readOnlyCandidateNeverEmitsTrustedPass": true,
      "realHostMustVerifyCanonicalEvidenceForReady": true,
      "buttonsBeforeTrustedPass": [
        "prepare",
        "status"
      ],
      "buttonsAfterTrustedPass": [
        "end-to-end",
        "continue",
        "status"
      ],
      "doNotInferNativeDeployment": true
    }
  }
}
