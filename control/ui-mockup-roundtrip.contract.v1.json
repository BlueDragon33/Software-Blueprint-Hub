{
  "schemaVersion": "1.0.0",
  "kind": "ui-mockup-roundtrip-contract",
  "policyId": "blueprint-os:ui-mockup-roundtrip",
  "policyVersion": "1.0.0",
  "status": "candidate-not-ratified",
  "owner": "BlueDragon33/Software-Blueprint-Hub",
  "parent": {
    "policyId": "blueprint-os:universal-century-grade",
    "minimumVersion": "1.3.0",
    "authority": "active-constitution-wins",
    "ratify": "authenticated-human-only"
  },
  "recordSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UI mockup exact provenance record",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "mockupId",
      "appId",
      "repository",
      "route",
      "surfaceId",
      "uiState",
      "sourceSha",
      "image",
      "spec",
      "status",
      "presentationScope",
      "mappings",
      "createdAt",
      "designApproval",
      "policyVersion",
      "viewport"
    ],
    "properties": {
      "schemaVersion": {
        "const": "1.0.0"
      },
      "mockupId": {
        "type": "string",
        "pattern": "^mockup:[a-z0-9-]+:[a-z0-9-]+:v[1-9][0-9]*$"
      },
      "appId": {
        "type": "string",
        "pattern": "^project:[a-z0-9-]+$"
      },
      "repository": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      },
      "route": {
        "type": "string",
        "pattern": "^/[a-zA-Z0-9_./-]*$"
      },
      "surfaceId": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "uiState": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "sourceSha": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "policyVersion": {
        "type": "string",
        "const": "1.3.0"
      },
      "viewport": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "mobile",
            "tablet",
            "desktop"
          ]
        }
      },
      "image": {
        "allOf": [
          {
            "$ref": "#/$defs/digestedArtifact"
          },
          {
            "properties": {
              "mediaType": {
                "enum": [
                  "image/png",
                  "image/webp"
                ]
              }
            }
          }
        ]
      },
      "spec": {
        "allOf": [
          {
            "$ref": "#/$defs/digestedArtifact"
          },
          {
            "properties": {
              "mediaType": {
                "const": "application/json"
              }
            }
          }
        ]
      },
      "status": {
        "enum": [
          "draft",
          "approved",
          "superseded",
          "rejected",
          "stale"
        ]
      },
      "presentationScope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowedChanges",
          "forbiddenChanges",
          "allowedSourcePaths"
        ],
        "properties": {
          "allowedChanges": {
            "type": "array",
            "items": {
              "enum": [
                "layout",
                "spacing",
                "typography",
                "color-tokens",
                "icon-styling",
                "responsive-composition",
                "visual-hierarchy"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "forbiddenChanges": {
            "type": "array",
            "items": {
              "enum": [
                "business-actions",
                "new-routes",
                "api-changes",
                "schema-changes",
                "authorization-changes",
                "secret-changes",
                "production-release",
                "data-fields"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "allowedSourcePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      },
      "mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "componentId",
            "kind",
            "anchor",
            "actionId",
            "dataBinding",
            "stateBinding"
          ],
          "properties": {
            "componentId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]+$"
            },
            "kind": {
              "enum": [
                "interactive",
                "data-bound",
                "visual-only"
              ]
            },
            "anchor": {
              "type": [
                "string",
                "null"
              ]
            },
            "actionId": {
              "type": [
                "string",
                "null"
              ]
            },
            "dataBinding": {
              "type": [
                "string",
                "null"
              ]
            },
            "stateBinding": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "designApproval": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "approvedByPrincipal",
          "approvedAt",
          "imageSha256",
          "specSha256"
        ],
        "properties": {
          "approvedByPrincipal": {
            "type": "string",
            "minLength": 3
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time"
          },
          "imageSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "specSha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      },
      "supersedes": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "$defs": {
      "digestedArtifact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "mediaType"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^artifacts/ui-mockups/[a-z0-9-]+/[a-zA-Z0-9._-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/webp",
              "application/json"
            ]
          }
        }
      }
    }
  },
  "invariants": {
    "noInventedCapability": true,
    "noRawSecrets": true,
    "sourceShaRequired": true,
    "imageAndSpecAlwaysRequired": true,
    "strictScopeMapping": true,
    "singleCurrentApprovedPerAppSurfaceState": true,
    "explicitHumanDesignApproval": true,
    "immutableApprovedVersions": true,
    "noImageGenerationOnApply": true,
    "noAutoConstitutionRatification": true,
    "noSelfQualityGatePass": true,
    "noImplicitProductionAuthority": true,
    "crossRepoDataOwnership": "app-repository-or-trusted-evidence-store",
    "hubOwns": "governance-registry-references-and-alias-dags-only"
  },
  "commands": {
    "CREATE_MOCKUP": {
      "codeChanges": false,
      "imageGeneration": "one-static-image",
      "resultStatus": "draft",
      "ambiguity": "BLOCK"
    },
    "APPROVE_MOCKUP": {
      "codeChanges": false,
      "imageGeneration": "never",
      "authority": "authenticated-design-owner-only",
      "target": "exact-id-and-digests"
    },
    "APPLY_APPROVED_MOCKUP": {
      "imageGeneration": "never",
      "requiresStatus": "approved",
      "sourceReconciliation": "required",
      "changes": "allowlisted-existing-UI-only",
      "resultStatus": "implemented-candidate",
      "qualityGatePassed": false,
      "productionAuthorized": false
    }
  },
  "resolution": {
    "scope": "appId+surfaceId+route+uiState",
    "onZeroMatch": "BLOCK",
    "onMultipleMatches": "BLOCK",
    "onStaleSource": "RECONCILE_OR_BLOCK",
    "onMismatch": "BLOCK"
  },
  "verify": {
    "required": [
      "real-rendered-image-hash",
      "source-and-approved-spec-digests",
      "component-action-data-mapping",
      "responsive-viewport-comparison",
      "keyboard-and-contrast-checks",
      "critical-business-regression",
      "independent-ux-review",
      "rollback-source-revision"
    ],
    "noUniversalPixelThreshold": true
  }
}
