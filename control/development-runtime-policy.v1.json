{
  "schemaVersion": "1.0.0",
  "kind": "ecosystem-development-runtime-policy",
  "policySource": "owner-directions-2026-10-16-and-2026-11-21",
  "universalConstitutionVersion": "1.3.0",
  "scope": "all-current-and-future-governed-applications",
  "defaultMode": "offline-local-only",
  "defaultRemotePublication": "disabled",
  "exceptionRepositories": [
    "BlueDragon33/BOIECH_AI"
  ],
  "exceptionMeaning": "Preserve BOIECH_AI existing offline-runtime exemption and project-specific protections; release-by-Owner preference extends to governed apps only after explicit adoption and gates.",
  "localRuntime": {
    "networkRequiredForCore": false,
    "localhostAllowed": true,
    "localDataPersistenceRequired": true,
    "cloudSyncOptional": true,
    "remoteControlOptional": true,
    "appManagementMandatory": false
  },
  "release": {
    "autoDeployOnPush": false,
    "autoDeployOnCIComplete": false,
    "onlineWorkflowMustRequireExplicitFutureOwnerOptIn": true,
    "onlinePublicationUnauthorizedByThisPolicy": true,
    "preserveFutureManualReleaseWorkflows": true,
    "previewDeploymentMandatory": false,
    "previewDeploymentOptional": true,
    "manualDirectProductionPreferredAfterExactShaGates": true,
    "ownerPowerShellDispatchRequired": true,
    "exactApprovedShaAndNamedProductionEnvironmentRequired": true,
    "autoDeployOnMerge": false,
    "productionGateAndRollbackEvidenceRequired": true,
    "productionProgressTrackingLinkRequired": true,
    "actualRunUrlOnlyAfterVerifiedDispatch": true,
    "crossProjectDispatchAuthorityGranted": false
  },
  "evidence": {
    "offlineUsable": "UNVERIFIED_UNTIL_APP_SPECIFIC_TEST",
    "legacyLiveDeployments": "NOT_REVOKED",
    "localInstallArtifact": "PROJECT_SPECIFIC"
  },
  "inventoryPolicy": "control/constitution-governed-repositories.json + admitted registrations and onboarding queue; do not alter sealed constitutional register",
  "notes": "Preserve offline-first installed runtime and ZERO-SPEND; online production is protected, app-specific and manually Owner-dispatched after real gate evidence, with Preview optional. Existing live URLs remain unchanged; no automatic deployment or constitutional ratification."
}
