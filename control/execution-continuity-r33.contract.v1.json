{
  "schemaVersion": "1.0.0",
  "kind": "execution-continuity-r33-contract",
  "status": "candidate-not-ratified",
  "parent": {
    "policyId": "blueprint-os:universal-century-grade",
    "policyVersion": "1.3.0",
    "preserveArticles": [
      "10.R15",
      "10.R16",
      "10.R17",
      "10.R19",
      "10.R20"
    ],
    "amendmentCandidate": "10.R33"
  },
  "ownership": {
    "governance": "BlueDragon33/Software-Blueprint-Hub",
    "checkpoint": "existing-authorized-issue-pr-journal",
    "additionalRuntimeDatabase": false,
    "rawSecretsAllowed": false
  },
  "checkpointSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "projectId",
      "repository",
      "workItemRef",
      "objective",
      "branch",
      "observedHead",
      "checkpointRef",
      "checkpointStatus",
      "nextAction",
      "evidence",
      "inFlightMutation"
    ],
    "properties": {
      "schemaVersion": {
        "const": "1.0.0"
      },
      "projectId": {
        "type": "string",
        "pattern": "^project:[a-z0-9-]+$"
      },
      "repository": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      },
      "workItemRef": {
        "type": "string",
        "minLength": 8
      },
      "objective": {
        "type": "string",
        "minLength": 8,
        "maxLength": 300
      },
      "branch": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "observedHead": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "checkpointRef": {
        "type": "string",
        "minLength": 8
      },
      "checkpointStatus": {
        "enum": [
          "VERIFIED_DONE",
          "VERIFIED_PENDING",
          "BLOCKED",
          "UNVERIFIED"
        ]
      },
      "nextAction": {
        "type": "string",
        "maxLength": 300
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "sha",
            "kind"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 8
            },
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "kind": {
              "enum": [
                "commit",
                "pull_request",
                "issue",
                "ci",
                "journal"
              ]
            }
          }
        }
      },
      "inFlightMutation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "outcome",
          "targetRef",
          "idempotencyKey"
        ],
        "properties": {
          "kind": {
            "enum": [
              "none",
              "mutation"
            ]
          },
          "outcome": {
            "enum": [
              "none",
              "confirmed-applied",
              "confirmed-not-applied",
              "unknown"
            ]
          },
          "targetRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "idempotencyKey": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "invariants": {
    "neverAssumeTransportErrorMeansTaskFailure": true,
    "independentReadbackBeforeRetry": true,
    "noFakeSuccess": true,
    "noNewAuthority": true,
    "noBackgroundPromise": true,
    "checkCurrentHead": true,
    "noDuplicateSideEffects": true,
    "noFullRepoScanByDefault": true,
    "productionAuthorized": false,
    "qualityGatePassed": false
  },
  "resultStatuses": [
    "RECONCILED_NEXT_ACTION",
    "VERIFIED_DONE",
    "BLOCKED",
    "UNVERIFIED",
    "STALE_CHECKPOINT",
    "MUTATION_OUTCOME_UNKNOWN",
    "AMBIGUOUS_WORK_ITEM",
    "CHECKPOINT_NOT_PERSISTED"
  ],
  "bindings": {
    "minimumTrustedReadback": [
      "checkpoint-reference-exists",
      "current-branch-head-observed",
      "relevant-side-effect-target-reconciled",
      "evidence-linked-to-exact-SHA"
    ],
    "runtimeCanActFromCandidate": false,
    "requiresExistingAuthorizedConnectors": true
  },
  "intents": {
    "RESUME_VERIFIED_WORK": {
      "writesAllowedOnlyAfterReconciliation": true,
      "unverifiedMutation": "BLOCK",
      "scope": "single-work-item-one-next-action"
    },
    "PERSIST_CHECKPOINT": {
      "writes": "existing-authorized-record-only",
      "requiresEvidence": true,
      "ifUnavailable": "CHECKPOINT_NOT_PERSISTED"
    },
    "REPORT_CHECKPOINT": {
      "writesAllowed": false,
      "mode": "read-only"
    }
  }
}
