{
  "schemaVersion": "1.0.0",
  "kind": "execution-service-boundary-protocol",
  "status": "candidate-integration-contract",
  "owner": "BlueDragon33/Software-Blueprint-Hub",
  "constitution": {
    "policyId": "blueprint-os:universal-century-grade",
    "policyVersion": "1.3.0"
  },
  "services": [
    {
      "role": "gateway",
      "repository": "BlueDragon33/Software-Blueprint-Execution-Gateway",
      "projectId": "project:software-blueprint-execution-gateway",
      "responsibility": "verify independent issuer signature, adoption, freshness, scoped permissions and durable one-time claim; sign bounded dispatch",
      "neverGrants": [
        "constitution-ratification",
        "canonical-quality-gate-pass",
        "production-release"
      ]
    },
    {
      "role": "executor",
      "repository": "BlueDragon33/Software-Blueprint-Execution-Worker",
      "projectId": "project:software-blueprint-execution-worker",
      "responsibility": "verify separately pinned Gateway public key, consume signed scope, read exact GitHub SHA, write/read durable Hub attempt",
      "neverGrants": [
        "arbitrary-shell",
        "unauthorized-code-writes",
        "canonical-quality-gate-pass",
        "production-release"
      ]
    },
    {
      "role": "independent-qa",
      "repository": "BlueDragon33/Software-Blueprint-QA-Worker",
      "projectId": "project:software-blueprint-qa-worker",
      "responsibility": "verify Gateway signature independently, read exact Hub journal attempt and GitHub byte stream, persist immutable QA proof",
      "neverGrants": [
        "self-certified-qa-pass",
        "completion-receipt-signature",
        "production-release"
      ]
    }
  ],
  "wire": {
    "format": "canonical-json-sorted-object-keys; arrays preserve order",
    "signature": "Ed25519 detached base64 over canonical JSON payload (signature field excluded)",
    "version": "1.0.0",
    "issuerGrantFields": [
      "schemaVersion",
      "projectId",
      "repository",
      "appHead",
      "workflowId",
      "workflowDigest",
      "canonicalDigest",
      "nodeId",
      "policyVersion",
      "mode",
      "issuerId",
      "nonce",
      "issuedAt",
      "expiresAt",
      "allowedPaths",
      "maxFiles",
      "maxBytes",
      "signature"
    ],
    "gatewayDispatchFields": [
      "schemaVersion",
      "kind",
      "requestId",
      "projectId",
      "repository",
      "appHead",
      "nodeId",
      "workflowDigest",
      "canonicalDigest",
      "policyVersion",
      "mode",
      "allowedPaths",
      "maxFiles",
      "maxBytes",
      "expiresAt",
      "signature"
    ],
    "workerObservationFields": [
      "schemaVersion",
      "kind",
      "requestId",
      "projectId",
      "repository",
      "appHead",
      "nodeId",
      "workflowDigest",
      "canonicalDigest",
      "policyVersion",
      "mode",
      "files",
      "observationDigest",
      "attempt",
      "filesTouched",
      "tokensUsed",
      "outcome"
    ],
    "hubAttemptFields": [
      "attempt",
      "outcome",
      "observationDigest",
      "evidenceReferences",
      "filesTouched",
      "tokensUsed"
    ],
    "hubIndependentQaFields": [
      "requestId",
      "attempt",
      "observationDigest",
      "sourceRevision",
      "verifierId",
      "verifiedFiles"
    ],
    "allowedModes": [
      "inspect-scoped"
    ],
    "mandatorySourceBindings": [
      "appHead",
      "workflowDigest",
      "canonicalDigest",
      "policyVersion"
    ],
    "budgets": {
      "maxFiles": 10,
      "maxBytes": 512000,
      "maxGrantLifetimeSeconds": 600,
      "maxAttempts": 1,
      "maxTokensUsed": 0
    }
  },
  "durability": {
    "canonicalDatabaseOwner": "BlueDragon33/Software-Blueprint-Hub",
    "workerClaimNamespace": "worker-distinct-from-gateway-issued-grant-claim",
    "hubAttemptAdapter": "PostgresWorkflowExecutionJournal",
    "qaVerificationAdapter": "PostgresWorkflowInspectionQaJournal",
    "evidenceMode": "read-only-sha256-pinned-github-source",
    "qaStatus": "verified-inspection-bytes",
    "qualityGatePassed": false,
    "completionReceiptIssued": false,
    "productionAuthorized": false
  },
  "deployment": {
    "authenticationState": "NOT_CONFIGURED",
    "privateCrossRepoCredentialBridge": "NOT_CONFIGURED",
    "previewServiceToServiceE2E": "NOT_VERIFIED",
    "previewDatabaseMigration": "ISOLATED_NEON_BRANCH_TEST_ONLY",
    "productionAuthority": false
  },
  "boundaries": [
    "Never mint keys from prompt or repository manifests",
    "Never trust client-provided readiness, source HEAD, or role labels",
    "No secrets or production passwords in source",
    "Require independently pinned Ed25519 issuer and Gateway public keys",
    "Separate each service replay claim storage from Hub canonical attempt and QA immutable storage",
    "No arbitrary shell, provider agent, file write, Quality Gate PASS, or production promotion in inspect-scoped v1",
    "All attempts are bounded, source-bound and fail closed"
  ]
}
