{
  "schemaVersion": "1.0.0",
  "kind": "worker-local-adapter-build-trust-proposal",
  "status": "PROPOSED_NOT_APPROVED",
  "constitutionVersion": "1.3.0",
  "approvedForExecution": false,
  "cloudDeploymentAllowed": false,
  "canonicalDatabaseAccessAllowed": false,
  "networkEgressPolicy": "NPM_REGISTRY_METADATA_AND_TARBALL_FETCH_ONLY_IN_DISPOSABLE_AUDIT",
  "selectedAdapter": "NONE",
  "packageSources": [
    {
      "name": "vinext",
      "version": "1.4.0",
      "role": "candidate_adapter_source"
    },
    {
      "name": "@opennextjs/cloudflare",
      "version": "1.20.15",
      "role": "alternative_adapter_peer_incompatible"
    },
    {
      "name": "next",
      "version": "16.3.6",
      "role": "existing_runtime"
    },
    {
      "name": "esbuild",
      "version": "0.28.2",
      "role": "blocked_install_script_candidate"
    },
    {
      "name": "@esbuild/linux-x64",
      "version": "0.28.2",
      "role": "native_binary_supply_chain_dependency"
    },
    {
      "name": "workerd",
      "version": "1.20261023.1",
      "role": "blocked_install_script_candidate"
    },
    {
      "name": "@cloudflare/workerd-linux-64",
      "version": "1.20261023.1",
      "role": "native_binary_supply_chain_dependency"
    }
  ],
  "installLifecycle": {
    "decision": "DENY",
    "approvedBuildScripts": [],
    "reviewOnlyCandidates": [
      {
        "name": "esbuild",
        "version": "0.28.2",
        "reason": "Observed pnpm ignored-builds; script and transitive integrity review required"
      },
      {
        "name": "workerd",
        "version": "1.20261023.1",
        "reason": "Observed pnpm ignored-builds; binary/platform provenance and postinstall review required"
      }
    ],
    "neverRun": [
      "npm install --ignore-scripts=false",
      "pnpm approve-builds",
      "pnpm config set dangerouslyAllowAllBuilds true",
      "vinext init",
      "wrangler deploy",
      "opennextjs-cloudflare deploy"
    ]
  },
  "artifactAudit": {
    "tarballScriptExecutionAllowed": false,
    "npmPackIgnoreScriptsRequired": true,
    "registryDeclaredSha512AndDownloadedBytesRequired": true,
    "tarballManifestNameVersionRequired": true,
    "packagePostinstallIsNotApproval": true,
    "nativeBinaryProvenanceRequiresSeparateReview": true
  },
  "localRuntimeSandbox": {
    "decision": "BLOCKED_AWAITING_INDEPENDENT_TOOLCHAIN_REVIEW",
    "runCloudflareCLI": false,
    "noCloudAccount": true,
    "noRealDatabaseCredentials": true,
    "noRemoteServiceBindings": true,
    "loopbackOnly": true,
    "readOnlyFixtures": true,
    "deniedProduction": true
  }
}
