{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint-os.example/schemas/uana-next-action.v1.json",
  "title": "UANA 1.0 derived next-action proposal (advisory only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "context",
    "options",
    "recommendedId",
    "candidateOnly",
    "requiresOwnerSend",
    "qualityGatePassed",
    "productionAuthorized",
    "derivedNotCanonical"
  ],
  "properties": {
    "schemaVersion": {
      "const": "uana:v1.0"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "projectName",
        "constitutionVersion",
        "sourceRevision",
        "projectionId",
        "repository",
        "headSha",
        "checkpointRef"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^project:[A-Za-z0-9_.:-]{2,110}$"
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "constitutionVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "projectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "headSha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "checkpointRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "projectId",
          "title",
          "description",
          "objective",
          "recommended",
          "workPackageId",
          "isReviewOnly"
        ],
        "properties": {
          "id": {
            "enum": [
              "inspect",
              "continue",
              "extend"
            ]
          },
          "projectId": {
            "type": "string",
            "pattern": "^project:[A-Za-z0-9_.:-]{2,110}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "recommended": {
            "type": "boolean"
          },
          "workPackageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "isReviewOnly": {
            "type": "boolean"
          }
        }
      }
    },
    "recommendedId": {
      "enum": [
        "inspect",
        "continue",
        "extend"
      ]
    },
    "candidateOnly": {
      "const": true
    },
    "requiresOwnerSend": {
      "const": true
    },
    "qualityGatePassed": {
      "const": false
    },
    "productionAuthorized": {
      "const": false
    },
    "derivedNotCanonical": {
      "const": true
    }
  },
  "$comment": "Cross-record projectId match, exact canonical revision freshness, Owner identity and real sending require the authorized application/host. This schema never authorizes an action."
}
