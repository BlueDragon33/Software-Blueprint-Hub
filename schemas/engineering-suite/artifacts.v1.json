{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.local/schemas/engineering-suite/artifacts.v1.json",
  "title": "Blue Dragon Engineering Suite Artifacts v1",
  "oneOf": [
    {
      "$ref": "#/$defs/pcbMechanicalPackage"
    },
    {
      "$ref": "#/$defs/mechanicalConstraintPackage"
    },
    {
      "$ref": "#/$defs/simulationGeometryPackage"
    },
    {
      "$ref": "#/$defs/simulationResultSummary"
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId",
        "projectId",
        "projectRevision"
      ],
      "properties": {
        "appId": {
          "enum": [
            "cad-cam-3d",
            "ecad-design",
            "cae-simulation"
          ]
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "projectRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handedness",
        "upAxis",
        "lengthUnit"
      ],
      "properties": {
        "handedness": {
          "const": "right-handed"
        },
        "upAxis": {
          "const": "z"
        },
        "lengthUnit": {
          "const": "mm"
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "contractId",
        "contractVersion",
        "artifactId",
        "artifactRevision",
        "producer",
        "createdAt",
        "contentType",
        "payload"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "minLength": 1
        },
        "contractVersion": {
          "const": "1"
        },
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "artifactRevision": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "object"
        },
        "payload": {}
      }
    },
    "point2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xMm",
        "yMm"
      ],
      "properties": {
        "xMm": {
          "type": "number"
        },
        "yMm": {
          "type": "number"
        }
      }
    },
    "point3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xMm",
        "yMm",
        "zMm"
      ],
      "properties": {
        "xMm": {
          "type": "number"
        },
        "yMm": {
          "type": "number"
        },
        "zMm": {
          "type": "number"
        }
      }
    },
    "mountingHole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "xMm",
        "yMm",
        "diameterMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "xMm": {
          "type": "number"
        },
        "yMm": {
          "type": "number"
        },
        "diameterMm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "pcbMechanicalPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boardId",
        "outlineMm",
        "thicknessMm",
        "mountingHoles",
        "componentEnvelopes"
      ],
      "properties": {
        "boardId": {
          "type": "string",
          "minLength": 1
        },
        "outlineMm": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/point2"
          }
        },
        "thicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mountingHoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mountingHole"
          }
        },
        "componentEnvelopes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "xMm",
              "yMm",
              "zMm",
              "widthMm",
              "depthMm",
              "heightMm"
            ],
            "properties": {
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "xMm": {
                "type": "number"
              },
              "yMm": {
                "type": "number"
              },
              "zMm": {
                "type": "number"
              },
              "widthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "heightMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "pcbMechanicalPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "contractId": {
              "const": "engineering.ecad.pcb-mechanical-package"
            },
            "contentType": {
              "const": "application/vnd.blue-dragon.ecad-pcb-mechanical+json"
            },
            "frame": {
              "$ref": "#/$defs/frame"
            },
            "payload": {
              "$ref": "#/$defs/pcbMechanicalPayload"
            }
          },
          "required": [
            "frame"
          ]
        }
      ]
    },
    "mechanicalConstraintPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mountingTargets",
        "keepOuts",
        "connectorTargets"
      ],
      "properties": {
        "allowedBoardEnvelopeMm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "mountingTargets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mountingHole"
          }
        },
        "keepOuts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "xMm",
              "yMm",
              "zMm",
              "widthMm",
              "depthMm",
              "heightMm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "xMm": {
                "type": "number"
              },
              "yMm": {
                "type": "number"
              },
              "zMm": {
                "type": "number"
              },
              "widthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depthMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "heightMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "connectorTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "xMm",
              "yMm",
              "zMm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "xMm": {
                "type": "number"
              },
              "yMm": {
                "type": "number"
              },
              "zMm": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "mechanicalConstraintPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "contractId": {
              "const": "engineering.cad.mechanical-constraint-package"
            },
            "contentType": {
              "const": "application/vnd.blue-dragon.cad-mechanical-constraint+json"
            },
            "frame": {
              "$ref": "#/$defs/frame"
            },
            "payload": {
              "$ref": "#/$defs/mechanicalConstraintPayload"
            }
          },
          "required": [
            "frame"
          ]
        }
      ]
    },
    "simulationGeometryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "neutralGeometryRef",
        "bodies",
        "semanticSelections"
      ],
      "properties": {
        "neutralGeometryRef": {
          "type": "string",
          "minLength": 1
        },
        "bodies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "semanticName": {
                "type": "string"
              }
            }
          }
        },
        "semanticSelections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "sourceLineageIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "face",
                  "edge",
                  "body"
                ]
              },
              "sourceLineageIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "simulationGeometryPackage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "contractId": {
              "const": "engineering.cad.simulation-geometry-package"
            },
            "contentType": {
              "const": "application/vnd.blue-dragon.cad-simulation-geometry+json"
            },
            "frame": {
              "$ref": "#/$defs/frame"
            },
            "payload": {
              "$ref": "#/$defs/simulationGeometryPayload"
            }
          },
          "required": [
            "frame",
            "contentHash"
          ]
        }
      ]
    },
    "simulationResultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "studyId",
        "studyRevision",
        "sourceGeometryProjectId",
        "sourceGeometryRevision",
        "sourceGeometryHash",
        "analysisType",
        "solver",
        "solveStatus",
        "convergenceStatus"
      ],
      "properties": {
        "studyId": {
          "type": "string",
          "minLength": 1
        },
        "studyRevision": {
          "type": "string",
          "minLength": 1
        },
        "sourceGeometryProjectId": {
          "type": "string",
          "minLength": 1
        },
        "sourceGeometryRevision": {
          "type": "string",
          "minLength": 1
        },
        "sourceGeometryHash": {
          "type": "string",
          "minLength": 1
        },
        "analysisType": {
          "enum": [
            "static-linear",
            "thermal",
            "modal"
          ]
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "solveStatus": {
          "enum": [
            "passed",
            "warning",
            "failed"
          ]
        },
        "convergenceStatus": {
          "enum": [
            "converged",
            "not-converged",
            "not-applicable"
          ]
        },
        "extrema": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hotspotReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "simulationResultSummary": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "properties": {
            "contractId": {
              "const": "engineering.cae.simulation-result-summary"
            },
            "contentType": {
              "const": "application/vnd.blue-dragon.cae-simulation-result-summary+json"
            },
            "payload": {
              "$ref": "#/$defs/simulationResultPayload"
            }
          }
        }
      ]
    }
  }
}
