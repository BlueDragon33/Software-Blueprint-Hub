generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String             @id @db.VarChar(160)
  createdAt    DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(6)
  profile      ProjectProfile?
  authorities  ProjectAuthority[]
  workPackages WorkPackage[]
  qualityGates          QualityGate[]
  architectureDecisions ArchitectureDecision[]
  risks                 Risk[]
  technicalDebts        TechnicalDebt[]
  releases              ReleaseRecord[]
  lessons               LessonLearned[]
  promptSnapshots        PromptProjectionSnapshot[]
}

model ProjectProfile {
  id            String   @id @db.VarChar(160)
  projectId     String   @unique @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recordVersion])
}

model WorkPackage {
  id            String   @id @db.VarChar(160)
  projectId     String   @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  status        String   @db.VarChar(32)
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, recordVersion])
}

model QualityGate {
  id            String         @id @db.VarChar(160)
  projectId     String         @db.VarChar(160)
  schemaVersion String         @db.VarChar(32)
  recordVersion Int
  status        String         @db.VarChar(32)
  document      Json
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  evidence      GateEvidence[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, recordVersion])
}

model GateEvidence {
  id        String   @id @db.VarChar(160)
  gateId    String   @db.VarChar(160)
  kind      String   @db.VarChar(32)
  source    String   @db.VarChar(500)
  revision  String   @db.VarChar(160)
  document  Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  gate QualityGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([gateId, createdAt])
  @@index([source, revision])
}


model ArchitectureDecision {
  id            String   @id @db.VarChar(160)
  projectId     String   @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  status        String   @db.VarChar(32)
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, recordVersion])
}

model Risk {
  id            String   @id @db.VarChar(160)
  projectId     String   @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  likelihood    String   @db.VarChar(16)
  impact        String   @db.VarChar(16)
  status        String   @db.VarChar(32)
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, likelihood, impact])
  @@index([projectId, recordVersion])
}

model TechnicalDebt {
  id            String   @id @db.VarChar(160)
  projectId     String   @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  severity      String   @db.VarChar(16)
  status        String   @db.VarChar(32)
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([projectId, severity])
  @@index([projectId, recordVersion])
}


model ReleaseRecord {
  id            String   @id @db.VarChar(160)
  projectId     String   @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  version       String   @db.VarChar(120)
  revision      String   @db.VarChar(160)
  environment   String   @db.VarChar(120)
  status        String   @db.VarChar(32)
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lessons LessonLearned[]

  @@index([projectId, status])
  @@index([projectId, revision])
  @@index([projectId, recordVersion])
}

model LessonLearned {
  id            String   @id @db.VarChar(160)
  projectId     String   @db.VarChar(160)
  releaseId     String?  @db.VarChar(160)
  schemaVersion String   @db.VarChar(32)
  recordVersion Int
  category      String   @db.VarChar(32)
  document      Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  release ReleaseRecord? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([projectId, category])
  @@index([projectId, recordVersion])
  @@index([releaseId])
}


model PromptProjectionSnapshot {
  snapshotKey     String   @id @db.VarChar(255)
  projectId       String   @db.VarChar(160)
  projectionId    String   @db.VarChar(160)
  sourceRevision  String   @db.VarChar(160)
  templateVersion String   @db.VarChar(120)
  contentHash     String   @db.VarChar(160)
  generatedAt     DateTime @db.Timestamptz(6)
  document        Json
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, generatedAt])
  @@index([projectId, sourceRevision])
  @@index([projectId, contentHash])
}

model Principal {
  id              String                @id @db.VarChar(160)
  provider        String                @db.VarChar(80)
  providerSubject String                @db.VarChar(255)
  email           String?               @db.VarChar(320)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  systemBootstrap SystemBootstrap?
  authorities     ProjectAuthority[]
  auditActor      AuthorityAuditEvent[] @relation("AuthorityAuditActor")
  auditTarget     AuthorityAuditEvent[] @relation("AuthorityAuditTarget")
  professionalReviewDecisions HumanProfessionalReviewDecision[]
  constitutionAmendments ConstitutionAmendment[] @relation("ConstitutionAmendmentProposer")
  constitutionAmendmentRevisions ConstitutionAmendmentRevision[] @relation("ConstitutionAmendmentRevisionActor")
  constitutionEvidence ConstitutionEvidence[] @relation("ConstitutionEvidenceActor")
  constitutionRatificationDecisions ConstitutionRatificationDecision[] @relation("ConstitutionRatificationReviewer")

  @@unique([provider, providerSubject])
}

model SystemBootstrap {
  id               String   @id @default("system") @db.VarChar(32)
  ownerPrincipalId String   @unique @db.VarChar(160)
  initializedAt    DateTime @default(now()) @db.Timestamptz(6)

  owner Principal @relation(fields: [ownerPrincipalId], references: [id], onDelete: Restrict)
}

model ProjectAuthority {
  projectId   String   @db.VarChar(160)
  principalId String   @db.VarChar(160)
  role        String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  principal Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@id([projectId, principalId])
  @@index([principalId, role])
}

model AuthorityAuditEvent {
  id                String   @id @db.VarChar(160)
  actorPrincipalId  String   @db.VarChar(160)
  targetPrincipalId String?  @db.VarChar(160)
  projectId         String?  @db.VarChar(160)
  action            String   @db.VarChar(80)
  detail            Json?
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  actor  Principal  @relation("AuthorityAuditActor", fields: [actorPrincipalId], references: [id], onDelete: Restrict)
  target Principal? @relation("AuthorityAuditTarget", fields: [targetPrincipalId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([actorPrincipalId, createdAt])
}


model HumanProfessionalReviewDecision {
  id                         String   @id @db.VarChar(160)
  projectId                  String   @db.VarChar(160)
  reviewerActorId            String   @db.VarChar(160)
  source                     String   @db.VarChar(80)
  decision                   String   @db.VarChar(32)
  decidedAt                  DateTime @db.Timestamptz(6)
  note                       String   @db.Text
  candidateReviewedRevision  String   @db.VarChar(160)
  candidateEvidenceDigest    String   @db.VarChar(160)
  acknowledgedFindingIds     Json
  humanSignoff               Boolean
  p9020TransitionAllowed     Boolean
  productionReleaseAuthority Boolean  @default(false)
  blockers                   Json
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)

  reviewer Principal @relation(fields: [reviewerActorId], references: [id], onDelete: Restrict)

  @@unique([projectId, candidateReviewedRevision, candidateEvidenceDigest])
  @@index([reviewerActorId, decidedAt])
  @@index([projectId, decidedAt])
}


model ConstitutionAmendment {
  id                  String   @id @db.VarChar(160)
  schemaVersion       String   @db.VarChar(32)
  recordVersion       Int
  basePolicyVersion   String   @db.VarChar(80)
  targetPolicyVersion String   @db.VarChar(80)
  title               String   @db.VarChar(240)
  state               String   @db.VarChar(40)
  proposedByActorId   String   @db.VarChar(160)
  document            Json
  createdAt           DateTime @db.Timestamptz(6)
  updatedAt           DateTime @db.Timestamptz(6)

  proposedBy Principal @relation("ConstitutionAmendmentProposer", fields: [proposedByActorId], references: [id], onDelete: Restrict)
  revisions ConstitutionAmendmentRevision[]
  evidence ConstitutionEvidence[]
  ratificationDecisions ConstitutionRatificationDecision[]

  @@index([state, updatedAt])
  @@index([targetPolicyVersion])
  @@index([proposedByActorId, updatedAt])
}

model ConstitutionAmendmentRevision {
  id                String   @id @db.VarChar(200)
  amendmentId       String   @db.VarChar(160)
  recordVersion     Int
  state             String   @db.VarChar(40)
  actorPrincipalId  String   @db.VarChar(160)
  action            String   @db.VarChar(80)
  document          Json
  createdAt         DateTime @db.Timestamptz(6)

  amendment ConstitutionAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  actor Principal @relation("ConstitutionAmendmentRevisionActor", fields: [actorPrincipalId], references: [id], onDelete: Restrict)

  @@unique([amendmentId, recordVersion])
  @@index([amendmentId, createdAt])
  @@index([actorPrincipalId, createdAt])
}

model ConstitutionEvidence {
  id                String   @id @db.VarChar(160)
  amendmentId       String   @db.VarChar(160)
  kind              String   @db.VarChar(32)
  source            String   @db.VarChar(500)
  revision          String   @db.VarChar(160)
  digest            String   @db.VarChar(160)
  note              String   @db.Text
  recordedByActorId String   @db.VarChar(160)
  document          Json
  createdAt         DateTime @db.Timestamptz(6)

  amendment ConstitutionAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  recordedBy Principal @relation("ConstitutionEvidenceActor", fields: [recordedByActorId], references: [id], onDelete: Restrict)

  @@index([amendmentId, kind, createdAt])
  @@index([source, revision])
  @@index([recordedByActorId, createdAt])
}

model ConstitutionRatificationDecision {
  id                     String   @id @db.VarChar(160)
  amendmentId            String   @db.VarChar(160)
  amendmentRecordVersion Int
  reviewerActorId        String   @db.VarChar(160)
  source                 String   @db.VarChar(80)
  decision               String   @db.VarChar(24)
  note                   String   @db.Text
  decidedAt              DateTime @db.Timestamptz(6)
  humanRatification      Boolean
  productionReleaseAuthority Boolean @default(false)
  document               Json
  createdAt              DateTime @default(now()) @db.Timestamptz(6)

  amendment ConstitutionAmendment @relation(fields: [amendmentId], references: [id], onDelete: Restrict)
  reviewer Principal @relation("ConstitutionRatificationReviewer", fields: [reviewerActorId], references: [id], onDelete: Restrict)

  @@unique([amendmentId, amendmentRecordVersion])
  @@index([reviewerActorId, decidedAt])
  @@index([amendmentId, decidedAt])
}
