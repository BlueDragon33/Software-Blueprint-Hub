{
  "name": "blueprint-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @blueprint-os/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --fileParallelism=false",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "contracts:generate": "node scripts/generate-contract-types.mjs",
    "contracts:check": "pnpm contracts:generate && git diff --exit-code -- packages/contracts/src/generated/vertical-slice.ts",
    "schema:compat": "node scripts/check-schema-compatibility.mjs",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "ci": "pnpm contracts:check && pnpm schema:compat && pnpm check:truth && pnpm test:truth && pnpm prisma:generate && pnpm lint && pnpm typecheck && pnpm check:boundaries && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "check:truth": "node scripts/check-source-of-truth.mjs",
    "test:truth": "node --test tests/source-truth/source-truth-detector.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "10.11.0",
    "json-schema-to-typescript": "16.0.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0"
  }
}
