# Blueprint OS local / Development environment template
# Copy to .env.local and replace placeholders. Never commit real secrets.

DATABASE_URL=postgresql://blueprint:change-me@localhost:5432/blueprint
AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_ID=replace-with-github-oauth-client-id
GITHUB_SECRET=replace-with-github-oauth-client-secret

# Exact authenticated identity allowed to perform the one-time System Owner bootstrap.
BLUEPRINT_OWNER_BOOTSTRAP_PROVIDER=github
BLUEPRINT_OWNER_BOOTSTRAP_SUBJECT=replace-with-exact-github-provider-account-id

# Optional. Only for plain-HTTP loopback production-build parity.
# Never enable on an Internet-facing Preview or Production deployment.
BLUEPRINT_ALLOW_LOCAL_HTTP_AUTH=false
